{
  "name": "tigray-ramino-2",
  "version": "2.0.0",
  "private": true,
  "description": "Server-authoritative Firebase backend for Tigray Ramino 2.0",
  "main": "backend/index.cjs",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "test": "node --test tests/rules.test.cjs tests/backend.test.cjs",
    "test:telegram": "python -m unittest tests/telegram_test.py",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/firestore.rules.test.cjs\"",
    "test:emulators": "firebase emulators:exec --only auth,firestore,functions \"node --test tests/firestore.rules.test.cjs tests/functions.integration.test.cjs\"",
    "test:all": "npm test && npm run test:telegram && npm run test:emulators",
    "emulators": "firebase emulators:start --only auth,firestore,functions"
  },
  "dependencies": {
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "firebase-tools": "^15.36.0"
  }
}
